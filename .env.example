# contoh — salin menjadi .env (root) dan sesuaikan
NODE_ENV=development
# API
API_PORT=3001
API_HOST=0.0.0.0
DATABASE_URL=file:./dev.db
SESSION_SECRET=ganti-dengan-string-acak-min-32-karakter-untuk-dev
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:5173
# Web (dibaca Vite, harus diawali VITE_)
VITE_API_BASE_URL=/api
VITE_APP_NAME=SIMPUL
# Produksi (contoh Postgres, Phase 5)
# DATABASE_URL=postgresql://simpul:rahasia@db:5432/simpul
# COOKIE_SECURE=true
